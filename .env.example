# Server-side Magento / Fluid GraphQL endpoint.
MAGENTO_GRAPHQL_URL=https://commerce.example.com/graphql

# Optional Magento installation root. If omitted, it is derived from
# MAGENTO_GRAPHQL_URL by removing a trailing /graphql path.
MAGENTO_BASE_URL=https://commerce.example.com
MAGENTO_STORE_CODE=default

# Optional comma-separated extra Magento/CDN image hosts when media is served
# from a different origin than MAGENTO_BASE_URL.
MAGENTO_IMAGE_HOSTS=

# Optional public storefront label.
NEXT_PUBLIC_STORE_NAME=Chelmsford Safety Supplies

# Trusted CSS Admin origin used only for the fixed Company Portal app-switch callback.
CSS_ADMIN_URL=https://admin.csscdn.co.uk


# Magento GraphQL resilience/diagnostics. Server-side only.
# Requests fail closed after 15 seconds by default. Supported range: 1-60 seconds.
MAGENTO_GRAPHQL_TIMEOUT_MS=15000
# Set to 1 to log operation timing; threshold 0 logs every operation.
MAGENTO_GRAPHQL_TIMING=0
MAGENTO_GRAPHQL_TIMING_THRESHOLD_MS=0

# Optional manager-owned Employee -> Magento address preselection.
# Use a separate PostgreSQL account with SELECT permission only on
# css_admin.employee_delivery_address_assignment; never reuse Admin's writer.
# Without this value, Employee checkout requires manual address confirmation.
CSS_STORE_EMPLOYEE_ADDRESS_DATABASE_URL=

# cXML Level 1 PunchOut, disabled until buyer and Fluid acceptance.
# Reserve technical Magento customers even when the feature is disabled.
PUNCHOUT_ENABLED=0
PUNCHOUT_RESERVED_CUSTOMER_IDS=
# Protected JSON array of partner profiles; NEVER commit real SharedSecrets.
# See docs/PUNCHOUT.md for the exact field schema.
PUNCHOUT_PROFILES_JSON=
# preauthenticated strictly development only; fluid_exchange is production design.
PUNCHOUT_AUTH_MODE=fluid_exchange
PUNCHOUT_STORE_ORIGIN=https://store.example.com
PUNCHOUT_SESSION_DB_PATH=/var/lib/css-store/punchout.sqlite
PUNCHOUT_SESSION_TTL_SECONDS=1800
PUNCHOUT_MAX_CLOCK_SKEW_SECONDS=300
PUNCHOUT_MAX_BODY_BYTES=262144
PUNCHOUT_ASSERTION_PRIVATE_KEY_B64=
PUNCHOUT_ASSERTION_ISSUER=css-store-punchout
PUNCHOUT_ASSERTION_AUDIENCE=css-commerce
PUNCHOUT_ASSERTION_KEY_ID=css-store-punchout-v1
PUNCHOUT_ASSERTION_TTL_SECONDS=60
