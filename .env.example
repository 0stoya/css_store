# Server-side Magento / Fluid GraphQL endpoint.
MAGENTO_GRAPHQL_URL=https://commerce.example.com/graphql

# Optional Magento installation root. If omitted, it is derived from
# MAGENTO_GRAPHQL_URL by removing a trailing /graphql path.
MAGENTO_BASE_URL=https://commerce.example.com
MAGENTO_STORE_CODE=default

# Optional public storefront label.
NEXT_PUBLIC_STORE_NAME=Chelmsford Safety Supplies