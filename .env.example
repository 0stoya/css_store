# Server-side Magento / Fluid GraphQL endpoint.
MAGENTO_GRAPHQL_URL=https://commerce.example.com/graphql

# Optional Magento installation root. If omitted, it is derived from
# MAGENTO_GRAPHQL_URL by removing a trailing /graphql path.
MAGENTO_BASE_URL=https://commerce.example.com
MAGENTO_STORE_CODE=default

# Optional comma-separated extra Magento/CDN image hosts when media is served
# from a different origin than MAGENTO_BASE_URL.
MAGENTO_IMAGE_HOSTS=

# Optional public storefront label.
NEXT_PUBLIC_STORE_NAME=Chelmsford Safety Supplies

# Trusted CSS Admin origin used only for the fixed Company Portal app-switch callback.
CSS_ADMIN_URL=https://admin.csscdn.co.uk


# Magento GraphQL resilience/diagnostics. Server-side only.
# Requests fail closed after 15 seconds by default. Supported range: 1-60 seconds.
MAGENTO_GRAPHQL_TIMEOUT_MS=15000
# Set to 1 to log operation timing; threshold 0 logs every operation.
MAGENTO_GRAPHQL_TIMING=0
MAGENTO_GRAPHQL_TIMING_THRESHOLD_MS=0

# SAP Ariba PunchOut is disabled until a real non-production customer fixture
# and exact single-customer mapping are accepted.
SAP_PUNCHOUT_ENABLED=0

# Development bridge while Fluid #108 cannot be deployed:
#   preauthenticated = require an already logged-in exact test customer/company.
#   fluid_exchange   = production design using the bounded Fluid exchange.
# preauthenticated is rejected whenever NODE_ENV=production.
SAP_PUNCHOUT_AUTH_MODE=fluid_exchange

# Exact cXML Header credentials from the customer's SAP test profile.
SAP_PUNCHOUT_FROM_DOMAIN=
SAP_PUNCHOUT_FROM_IDENTITY=
SAP_PUNCHOUT_TO_DOMAIN=
SAP_PUNCHOUT_TO_IDENTITY=
SAP_PUNCHOUT_SENDER_DOMAIN=
SAP_PUNCHOUT_SENDER_IDENTITY=
SAP_PUNCHOUT_SHARED_SECRET=

# Exact Magento / Fluid principal. Do not infer or populate until confirmed.
SAP_PUNCHOUT_MAGENTO_CUSTOMER_ID=
SAP_PUNCHOUT_COMPANY_ID=
SAP_PUNCHOUT_STORE_CODE=

# Comma-separated HTTPS hostnames only, without scheme/path/port.
SAP_PUNCHOUT_ALLOWED_RETURN_HOSTS=

# Fixed public css_store origin and durable local session database.
SAP_PUNCHOUT_STORE_ORIGIN=https://store.example.com
SAP_PUNCHOUT_SESSION_DB_PATH=/var/lib/css-store/punchout.sqlite
SAP_PUNCHOUT_SESSION_TTL_SECONDS=1800
SAP_PUNCHOUT_MAX_CLOCK_SKEW_SECONDS=300
SAP_PUNCHOUT_MAX_BODY_BYTES=262144

# Required only for SAP_PUNCHOUT_AUTH_MODE=fluid_exchange.
# RS256 private key is base64-encoded PEM and remains on css_store only.
# Fluid receives only the matching public key.
SAP_PUNCHOUT_ASSERTION_PRIVATE_KEY_B64=
SAP_PUNCHOUT_ASSERTION_ISSUER=css-store-punchout
SAP_PUNCHOUT_ASSERTION_AUDIENCE=css-commerce
SAP_PUNCHOUT_ASSERTION_KEY_ID=css-store-punchout-v1
SAP_PUNCHOUT_ASSERTION_TTL_SECONDS=60
